# Copy to .env (never commit .env). Only VITE_* values reach the browser bundle, and those
# two are public by design (Supabase's anon key is safe to expose; row level security protects
# the data). Everything else is server-only. For the hosted version set these in Vercel's
# project settings instead (docs/DEPLOY.md).

# ---------------------------------------------------------------------------------------------
# Hosted version (Supabase + Vercel)
# ---------------------------------------------------------------------------------------------

# Browser: your Supabase project URL and anon (public) key. Leave empty for the local version.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server: the same URL, plus the service role key. Server-only; never prefix it with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key that encrypts Up tokens and SnapTrade keys at rest: `openssl rand -base64 32`.
SERVER_ENCRYPTION_KEY=

# Vercel sends this as a bearer token to /api/cron/daily: `openssl rand -hex 32`.
CRON_SECRET=

# The site's public address, used for Up's webhook and the same-origin check.
# PUBLIC_URL=https://your-app.vercel.app

# AI assistant (optional). Leave empty to switch it off.
ANTHROPIC_API_KEY=
# Hard monthly ceiling for the household, in Australian dollars.
AI_MONTHLY_CAP_AUD=10
# Australian dollars per US dollar, kept high on purpose so the ceiling is conservative.
AI_AUD_PER_USD=1.6

# Domain listings search for the house screener (optional; needs Domain's approval).
DOMAIN_CLIENT_ID=
DOMAIN_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# Local version (npm run dev, everything on this computer)
# ---------------------------------------------------------------------------------------------

# Where the API listens. Keep 127.0.0.1 unless it sits behind a sign-in proxy (docs/SECURITY.md).
API_PORT=8787
HOST=127.0.0.1
# WEB_PORT=5173

# Where the encrypted vault lives (default: server/.data). SERVER_ENCRYPTION_KEY above is
# required when NODE_ENV=production; in development a key is generated in server/.data/.
# DATA_DIR=

# Basiq (CDR intermediary). Leave empty to disable. Sandbox keys come from the Basiq dashboard.
BASIQ_API_KEY=
BASIQ_ENVIRONMENT=sandbox
# BASIQ_BASE_URL=https://au-api.basiq.io

# The mock provider is on in development and off in production unless enabled here.
# ENABLE_MOCK_PROVIDER=false
